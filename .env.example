# ===================================================
# SMARTFLOW HUB - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy these values into Vercel Settings -> Environment Variables
# ===================================================

# Paystack Public Key (starts with pk_live_... for real payments)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Paystack Secret Key (starts with sk_live_... for server-side verification)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# Resend API Key (starts with re_...)
RESEND_API_KEY=re_your_resend_api_key

# Sender email address (verified on Resend)
EMAIL_FROM=SMARTFLOW HUB <noreply@smartflowgroupltd.com>

# Admin email to receive registration notifications
ADMIN_NOTIFICATION_EMAIL=info@smartflowgroupltd.com

# Production Subdomain URL
NEXT_PUBLIC_APP_URL=https://techhub.smartflowgroupltd.com

# StaticForms API Key (https://api.staticforms.dev/submit)
STATICFORMS_API_KEY=sf_your_api_key_here

